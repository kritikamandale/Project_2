# =============================================================================
# SkinAI FastAPI — environment variables template
# Copy to .env and fill in your real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# JWT  (HS256 in dev; set jwt_private_key/jwt_public_key for RS256 in prod)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL  (Supabase, Neon, or local Docker)
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=skinai postgres:15
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skinai

# ---------------------------------------------------------------------------
# Redis  (local Docker or Upstash)
# docker run -d -p 6379:6379 redis:7
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AWS S3  (or MinIO for local dev)
# docker run -d -p 9000:9000 minio/minio server /data
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=skinai-uploads-dev

# ---------------------------------------------------------------------------
# Google Gemini  — FREE tier: 1M tokens/day, 15 RPM
# Get your free key at: https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Pinecone  — OPTIONAL: leave blank to use built-in PostgreSQL/pgvector fallback
# ---------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=skin-products

# ---------------------------------------------------------------------------
# Email — Resend  — https://resend.com
# Use onboarding@resend.dev as EMAIL_FROM for dev (no domain verification needed)
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=SkinAI

# ---------------------------------------------------------------------------
# Sentry  — https://sentry.io  (leave blank to disable)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# OpenWeatherMap  — https://openweathermap.org/api  (leave blank to disable)
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_DERMATOLOGIST_REVIEW=true
ENABLE_WAITLIST=false
MAX_SCANS_PER_USER_PER_DAY=3
