# =============================================================================
# Skinest FastAPI — environment variables template
# Copy to .env and fill in your real values. Never commit .env to git.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ALLOWED_ORIGINS=http://localhost:3100
FRONTEND_URL=http://localhost:3100
# Trust X-Forwarded-For only when the API runs behind a trusted reverse proxy
# (the Next.js proxy / a load balancer). Set to false if the API is ever exposed
# directly to clients, otherwise callers can spoof their IP.
TRUST_PROXY_HEADERS=true

# ---------------------------------------------------------------------------
# JWT  (HS256 in dev; set jwt_private_key/jwt_public_key for RS256 in prod)
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# PostgreSQL  (Supabase, Neon, or local Docker)
# docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=skinest postgres:15
# ---------------------------------------------------------------------------
# DATABASE_URL = privileged (schema-owner) role. Used by Alembic migrations and
# seed scripts (needs DDL + RLS bypass). In CI this is secrets.PRODUCTION_DATABASE_URL.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skinest
# APP_DATABASE_URL = least-privilege runtime role (must NOT have BYPASSRLS) so RLS
# is actually enforced in production. Leave BLANK for local dev against a sandbox
# Postgres — the superuser is fine locally and avoids role-management friction.
# In production set this to the dedicated app role (see scripts/create_app_role.sql).
APP_DATABASE_URL=

# ---------------------------------------------------------------------------
# Redis  (local Docker or Upstash)
# docker run -d -p 6379:6379 redis:7
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# AWS S3  (or MinIO for local dev)
# docker run -d -p 9000:9000 minio/minio server /data
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=skinest-uploads-dev

# ---------------------------------------------------------------------------
# Groq  — recommendation engine LLM (FREE tier: 14,400 req/day)
# Get your free key at: https://console.groq.com/keys
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Pinecone  — OPTIONAL: leave blank to use built-in PostgreSQL/pgvector fallback
# ---------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=skin-products

# ---------------------------------------------------------------------------
# Email — Gmail SMTP (Free: sends to ANY email without buying a domain) or Resend
# ---------------------------------------------------------------------------
# Option 1: Gmail SMTP (Recommended for 100% free delivery to any email)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-digit-gmail-app-password
SMTP_USE_TLS=true

# Option 2: Resend (Free tier with onboarding@resend.dev ONLY delivers to account owner)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=Skinest

# ---------------------------------------------------------------------------
# Sentry  — https://sentry.io  (leave blank to disable)
# ---------------------------------------------------------------------------
SENTRY_DSN=

# ---------------------------------------------------------------------------
# OpenWeatherMap  — https://openweathermap.org/api  (leave blank to disable)
# ---------------------------------------------------------------------------
OPENWEATHER_API_KEY=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_DERMATOLOGIST_REVIEW=true
ENABLE_WAITLIST=false
MAX_SCANS_PER_USER_PER_DAY=3
