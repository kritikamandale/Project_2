# =============================================================================
# AI SKIN ANALYSIS PLATFORM — ENVIRONMENT VARIABLES TEMPLATE
# Phase 10 — Security Hardening & Production Deployment
#
# Copy:
#   .env.example      → apps/api/.env          (FastAPI backend)
#   .env.local.example → apps/web/.env.local   (Next.js frontend)
#
# NEVER commit real values. NEVER put secrets in source code.
# Rotate all secrets every 90 days (see Secrets Rotation section below).
# =============================================================================

# -----------------------------------------------------------------------------
# NEXT.JS / FRONTEND
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_POSTHOG_KEY=                          # Leave blank to disable analytics
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
NEXT_PUBLIC_SENTRY_DSN=

# -----------------------------------------------------------------------------
# NEXTAUTH.JS v5
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=                                   # REQUIRED — min 32 chars

# OAuth Providers (optional social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# FASTAPI BACKEND — Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development                            # development | staging | production
DEBUG=true
APP_VERSION=1.0.0

# Secret key for CSRF / misc signing
# Generate: openssl rand -hex 32
SECRET_KEY=

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3100

# Trusted hosts for TrustedHostMiddleware (comma-separated)
# Production: yourdomain.com,www.yourdomain.com
TRUSTED_HOSTS=localhost,127.0.0.1

# Frontend URL (used in password reset / OTP email links)
FRONTEND_URL=http://localhost:3100

# -----------------------------------------------------------------------------
# JWT — Authentication Tokens
# HS256 dev: set JWT_SECRET_KEY only
# RS256 prod: set JWT_PRIVATE_KEY + JWT_PUBLIC_KEY (PEM, \n-escaped)
#
# Generate RS256 keys:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
#   Then: awk 'NF {sub(/\r/, ""); printf "%s\\n",$0;}' private.pem
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=                                    # HS256 dev fallback
JWT_PRIVATE_KEY=                                   # RS256 private PEM (production)
JWT_PUBLIC_KEY=                                    # RS256 public PEM (production)
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Auth Security
# -----------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=3
PASSWORD_RESET_EXPIRE_MINUTES=15

# Rate limiting (slowapi)
RATE_LIMIT_GENERAL=100/minute                      # public API endpoints
RATE_LIMIT_AUTH=5/hour                             # register / forgot-password
RATE_LIMIT_LOGIN=10/minute                         # login endpoint

# -----------------------------------------------------------------------------
# POSTGRESQL 15
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skin_analysis
POSTGRES_USER=skin_user
POSTGRES_PASSWORD=                                 # REQUIRED in production

# Full async DSN (used by FastAPI)
DATABASE_URL=postgresql+asyncpg://skin_user:password@localhost:5432/skin_analysis

# Connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# Backup bucket (for postgres-backup Docker service)
S3_BACKUP_BUCKET=skinanalysis-backups

# -----------------------------------------------------------------------------
# REDIS 7
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                                    # REQUIRED in production
REDIS_URL=redis://:password@localhost:6379/0

SESSION_TTL=3600                                   # seconds
CACHE_TTL=300

# -----------------------------------------------------------------------------
# AWS — S3 + Secrets Manager
# Use least-privilege IAM role in production (not root keys)
# Region: ap-south-1 (Mumbai) for Indian users — data residency
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=                                    # Used in ECR image URIs

# S3 buckets
S3_BUCKET_NAME=skinanalysis-temp-images            # Ephemeral face scan uploads
S3_BUCKET_DOCUMENTS=skinanalysis-documents         # Dermatologist license uploads
S3_PRESIGNED_URL_EXPIRY=60                         # seconds — images auto-deleted
S3_LIFECYCLE_EXPIRY_DAYS=1

# Secrets Manager (for 90-day secret rotation)
# AWS_SECRETS_MANAGER_REGION=ap-south-1            # same as AWS_REGION

# -----------------------------------------------------------------------------
# ANTHROPIC / CLAUDE API
# Rotate every 90 days at: console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=                                 # sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# PINECONE — Vector store for product embeddings
# Rotate every 90 days at: app.pinecone.io → API Keys
# -----------------------------------------------------------------------------
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=skin-products

# -----------------------------------------------------------------------------
# SENTRY — Error monitoring
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# EMAIL — Transactional (SendGrid recommended)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=                                     # SendGrid API key — SG.xxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Skinest

# -----------------------------------------------------------------------------
# CLIMATE API (Open-Meteo — free, no key required)
# -----------------------------------------------------------------------------
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
CLIMATE_CACHE_TTL=3600

# -----------------------------------------------------------------------------
# SECURITY — Admin & File uploads
# -----------------------------------------------------------------------------

# Admin IP allowlist (comma-separated) — only these IPs can reach /api/v1/admin/*
# Leave blank in development to allow all
ADMIN_IP_ALLOWLIST=

# File upload limits
FILE_UPLOAD_MAX_SIZE_BYTES=5242880                 # 5 MB
FILE_UPLOAD_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf

# ClamAV malware scanning (sidecar Docker service)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_ENABLED=false                               # Set true in production

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
ENABLE_DERMATOLOGIST_REVIEW=true
ENABLE_WAITLIST=false
ENABLE_ANALYTICS=true
MAX_SCANS_PER_USER_PER_DAY=3

# -----------------------------------------------------------------------------
# VERCEL / RAILWAY / DOCKER — Deployment
# (Set as GitHub Actions secrets, not in .env file)
# -----------------------------------------------------------------------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# RAILWAY_TOKEN=
# SLACK_WEBHOOK_URL=

# E2E test credentials (GitHub Actions secrets)
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_TEST_EMAIL=
# E2E_TEST_PASSWORD=

# =============================================================================
# SECRETS ROTATION SCHEDULE (every 90 days)
# =============================================================================
# | Secret                | Where to rotate              | Deadline  |
# |-----------------------|------------------------------|-----------|
# | JWT_PRIVATE_KEY       | Generate new RSA pair        | 90 days   |
# | NEXTAUTH_SECRET       | openssl rand -base64 32      | 90 days   |
# | ANTHROPIC_API_KEY     | console.anthropic.com        | 90 days   |
# | PINECONE_API_KEY      | app.pinecone.io              | 90 days   |
# | AWS keys              | AWS IAM → rotate access keys | 90 days   |
# | SMTP_PASSWORD         | SendGrid → API keys          | 90 days   |
# | POSTGRES_PASSWORD     | AWS RDS / manual             | 90 days   |
# | REDIS_PASSWORD        | Docker secret / manual       | 90 days   |
# =============================================================================
